{
  "name": "snippet-sprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "実コードのスニペットを打って学ぶ、Three.js 製プログラミング・タイピングゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.0"
    }
  }
}
