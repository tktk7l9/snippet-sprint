{
  "name": "snippet-sprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "実コードのスニペットを打って学ぶ、Three.js 製プログラミング・タイピングゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
