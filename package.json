{
  "name": "snippet-sprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "実コードのスニペットを打って学ぶ、Three.js 製プログラミング・タイピングゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify:snippets": "node --disable-warning=ExperimentalWarning scripts/verify-snippets.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.0.0",
    "wrangler": "^4.158.0"
  }
}
